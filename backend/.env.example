# Database
DATABASE_URL=postgresql+asyncpg://steamhub_user:steamhub_secret_password@localhost:5432/steamhub_db
# For sync alembic migrations:
SYNC_DATABASE_URL=postgresql://steamhub_user:steamhub_secret_password@localhost:5432/steamhub_db

# Steam Web API & OpenID
# One key held server-side, never exposed to client
STEAM_API_KEY=YOUR_STEAM_WEB_API_KEY_HERE
STEAM_OPENID_REALM=http://localhost:8000
STEAM_OPENID_RETURN_TO=http://localhost:8000/auth/steam/callback

# Security & JWT
JWT_SECRET_KEY=replace_with_a_secure_random_secret_minimum_32_bytes_long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=30
CSRF_SECRET_KEY=replace_with_a_secure_random_csrf_secret_minimum_32_bytes

# Poller Configuration
POLL_INTERVAL_MINUTES=15
STEAM_DAILY_QUOTA=100000

# Client Application
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
COOKIE_SECURE=false
